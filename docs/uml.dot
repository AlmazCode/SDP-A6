digraph UML {
graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.35, ranksep=0.65, fontname="DejaVu Sans", label="Assignment 6 · Variant 16 · Social network", labelloc=t, fontsize=22, compound=true];
node [shape=plain, fontname="DejaVu Sans", fontsize=11];
edge [fontname="DejaVu Sans", fontsize=10, color="#475569", arrowsize=0.8];
subgraph cluster_observer { label="Observer · synchronous push"; color="#cbd5e1"; style=rounded;
Subject [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#dbeafe"><B>«interface» Subject&lt;E&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ subscribe(type, Observer&lt;E&gt;)<BR ALIGN="LEFT"/>+ unsubscribe(type, Observer&lt;E&gt;)<BR ALIGN="LEFT"/>+ publish(E)</TD></TR></TABLE>>];
Observer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#dbeafe"><B>«interface» Observer&lt;E&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ onEvent(E): void</TD></TR></TABLE>>];
EventSource [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>EventSource</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- listeners: Map&lt;EventType,<BR ALIGN="LEFT"/>  CopyOnWriteArrayList&lt;Observer&gt;&gt;<BR ALIGN="LEFT"/>+ publish(SocialEvent)</TD></TR></TABLE>>];
PostSource [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>PostSource</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ post(Group, postId)</TD></TR></TABLE>>];
ReactionSource [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>ReactionSource</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ react(Group, contentId)</TD></TR></TABLE>>];
TrendingTracker [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>TrendingTracker</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- reactions: Map&lt;String, AtomicLong&gt;<BR ALIGN="LEFT"/>+ onEvent(SocialEvent)<BR ALIGN="LEFT"/>+ reactions(groupId): long</TD></TR></TABLE>>];
Feed [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>Feed</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- posts: ConcurrentLinkedQueue<BR ALIGN="LEFT"/>+ posts(): List&lt;String&gt;</TD></TR></TABLE>>];
NotificationCenter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>NotificationCenter</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- count: AtomicInteger<BR ALIGN="LEFT"/>+ count(): int</TD></TR></TABLE>>];
EventLog [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>EventLog</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- events: ConcurrentLinkedQueue<BR ALIGN="LEFT"/>+ events(): List&lt;SocialEvent&gt;</TD></TR></TABLE>>];
ModerationService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#fef3c7"><B>ModerationService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- reports: Subject&lt;SocialEvent&gt;<BR ALIGN="LEFT"/>+ onEvent(SocialEvent)</TD></TR></TABLE>>];
SocialEvent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#f1f5f9"><B>«record» SocialEvent</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ type: EventType<BR ALIGN="LEFT"/>+ group: Group<BR ALIGN="LEFT"/>+ detail: String<BR ALIGN="LEFT"/>+ value: long</TD></TR></TABLE>>];
EventType [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>«enum» EventType</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">POST_CREATED<BR ALIGN="LEFT"/>REACTION_ADDED<BR ALIGN="LEFT"/>TREND_UPDATED<BR ALIGN="LEFT"/>MODERATION_COMPLETED</TD></TR></TABLE>>];
EventSource -> Subject [style=dashed, arrowhead=empty];
PostSource -> EventSource [arrowhead=empty];
ReactionSource -> EventSource [arrowhead=empty];
TrendingTracker -> EventSource [arrowhead=empty];
EventSource -> Observer [dir=both, arrowtail=odiamond, arrowhead=none, label="listeners 0..*"];
SocialEvent -> EventType [arrowhead=vee];
ModerationService -> Subject [label="reports", arrowhead=vee, style=dashed];
Feed -> Observer [style=dashed, arrowhead=empty];
NotificationCenter -> Observer [style=dashed, arrowhead=empty];
EventLog -> Observer [style=dashed, arrowhead=empty];
ModerationService -> Observer [style=dashed, arrowhead=empty];
TrendingTracker -> Observer [style=dashed, arrowhead=empty];
}
subgraph cluster_visitor { label="Composite + Visitor · visitor owns traversal"; color="#cbd5e1"; style=rounded;
Element [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#dcfce7"><B>«interface» Element</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ id(): String<BR ALIGN="LEFT"/>+ accept(Visitor&lt;R&gt;): R</TD></TR></TABLE>>];
Visitor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#dcfce7"><B>«interface» Visitor&lt;R&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ visit(Community): R<BR ALIGN="LEFT"/>+ visit(Group): R<BR ALIGN="LEFT"/>+ visit(TextPost): R<BR ALIGN="LEFT"/>+ visit(Comment): R<BR ALIGN="LEFT"/>+ visit(Image): R<BR ALIGN="LEFT"/>+ visit(Video): R</TD></TR></TABLE>>];
Community [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>«record» Community</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ id: String<BR ALIGN="LEFT"/>+ children: List&lt;Group&gt;</TD></TR></TABLE>>];
Group [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>«record» Group</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ id: String<BR ALIGN="LEFT"/>+ children: List&lt;Element&gt;</TD></TR></TABLE>>];
TextPost [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>«record» TextPost</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ id, text: String<BR ALIGN="LEFT"/>+ likes: int</TD></TR></TABLE>>];
Comment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>«record» Comment</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ id, text: String<BR ALIGN="LEFT"/>+ likes: int</TD></TR></TABLE>>];
Image [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>«record» Image</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ id, caption: String<BR ALIGN="LEFT"/>+ likes: int</TD></TR></TABLE>>];
Video [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>«record» Video</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ id, caption: String<BR ALIGN="LEFT"/>+ likes: int<BR ALIGN="LEFT"/>+ durationSeconds: int</TD></TR></TABLE>>];
EngagementVisitor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>EngagementVisitor</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">«Visitor&lt;Long&gt;»<BR ALIGN="LEFT"/>sum of content likes</TD></TR></TABLE>>];
ModerationVisitor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#fef3c7"><B>ModerationVisitor</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">«Visitor&lt;Void&gt;»<BR ALIGN="LEFT"/>- reviewed: int<BR ALIGN="LEFT"/>- flaggedIds: List&lt;String&gt;</TD></TR></TABLE>>];
PopularContentVisitor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>PopularContentVisitor</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">«Visitor&lt;List&lt;Element&gt;&gt;»<BR ALIGN="LEFT"/>- minimumLikes: int</TD></TR></TABLE>>];
JsonVisitor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>JsonVisitor</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">«Visitor&lt;String&gt;»<BR ALIGN="LEFT"/>nested JSON + escaping</TD></TR></TABLE>>];
ContentCountVisitor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>ContentCountVisitor</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">«Visitor&lt;Integer&gt;»<BR ALIGN="LEFT"/>count of content leaves</TD></TR></TABLE>>];
Community -> Element [style=dashed, arrowhead=empty];
Group -> Element [style=dashed, arrowhead=empty];
TextPost -> Element [style=dashed, arrowhead=empty];
Comment -> Element [style=dashed, arrowhead=empty];
Image -> Element [style=dashed, arrowhead=empty];
Video -> Element [style=dashed, arrowhead=empty];
EngagementVisitor -> Visitor [style=dashed, arrowhead=empty];
ModerationVisitor -> Visitor [style=dashed, arrowhead=empty];
PopularContentVisitor -> Visitor [style=dashed, arrowhead=empty];
JsonVisitor -> Visitor [style=dashed, arrowhead=empty];
ContentCountVisitor -> Visitor [style=dashed, arrowhead=empty];
Community -> Group [dir=both, arrowtail=diamond, arrowhead=none, label="children 0..*"];
Group -> Element [dir=both, arrowtail=diamond, arrowhead=none, label="children 0..*"];
Element -> Visitor [style=dashed, arrowhead=vee, label="accept → visit(this)"];
Visitor -> Element [style=dashed, arrowhead=vee, label="child.accept(this)"];
}
Main [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>Main · composition root</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ main(String[]): void<BR ALIGN="LEFT"/>creates and wires dependencies</TD></TR></TABLE>>];
Producers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569"><TR><TD BGCOLOR="#e2e8f0"><B>Producers</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- executor: ExecutorService<BR ALIGN="LEFT"/>+ run(List&lt;Runnable&gt;): void<BR ALIGN="LEFT"/>waits for accepted work</TD></TR></TABLE>>];
Main -> Producers [style=dashed, arrowhead=vee, label="creates"];
SocialEvent -> Group [style=dashed, arrowhead=vee, label="immutable subtree", constraint=false];
ModerationService -> ModerationVisitor [style=dashed, arrowhead=vee, label="creates per event", color="#b45309", penwidth=2, constraint=false];
Visitor -> PostSource [style=invis, weight=100];
Observer -> Main [style=invis, weight=100];
Producers -> Legend [style=invis];
Legend [shape=box, fontsize=11, label="UML notation\lEmpty triangle: inheritance / realization (dashed)\lFilled diamond: composition · Open diamond: aggregation\lDashed arrow: dependency\lRecord fields are immutable accessors; methods omitted where inherited.\l"];
}
